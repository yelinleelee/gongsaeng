PORT=8080
DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/itda?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin SDK credentials — choose ONE of the two options below.
#
# Option A: Raw JSON (recommended for Railway / Heroku).
# Paste the entire contents of your service-account JSON as a single line.
FIREBASE_CREDENTIALS_JSON=
#
# Option B: Local file path (for local development).
# FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# Cloudinary — image hosting for property photos.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=itda/stays
